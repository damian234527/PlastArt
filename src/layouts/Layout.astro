---
interface Props {
	title: string;
    lang: string;
}
const { title, description, lang = "pl" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="PLASTart - Spawanie tworzyw sztucznych" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
    
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- i18n hreflang -->
		<link rel="alternate" hreflang="en" href={new URL('/en' + Astro.url.pathname.replace(/^\/(en|pl)/, ''), Astro.site)} />
		<link rel="alternate" hreflang="pl" href={new URL('/pl' + Astro.url.pathname.replace(/^\/(en|pl)/, ''), Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/en' + Astro.url.pathname.replace(/^\/(en|pl)/, ''), Astro.site)} />

		<!-- Open Graph / Social -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<style is:global>
			:root {
				--primary: #0a0a0a; /* Głęboka czerń z logo */
				--secondary: #ff0000; /* Mocna czerwień z logo */
				--bg: #f5f5f5; /* Delikatna szarość dla lepszego kontrastu z mocnymi kolorami */
				--text: #222222;
                --card-bg: #ffffff;
			}
			html { scroll-behavior: smooth; }
			body {
				margin: 0;
				font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
				background-color: var(--bg);
				color: var(--text);
				line-height: 1.6;
			}
			* { box-sizing: border-box; }
			.container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
			section { padding: 80px 0; }
			h1, h2, h3 { color: var(--primary); }
            h2 { font-size: 2.2rem; margin-bottom: 1.5rem; text-align: center; font-weight: 800; text-transform: uppercase; }
            h2::after { content: ''; display: block; width: 60px; height: 5px; background: var(--secondary); margin: 10px auto 0; border-radius: 0px;}
			a { color: var(--secondary); text-decoration: none; }
			
            header { background: var(--primary); color: white; padding: 1rem 0; position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 15px rgba(0,0,0,0.3); border-bottom: 4px solid var(--secondary); }
			.nav-container { display: flex; justify-content: space-between; align-items: center; }
			nav { display: flex; gap: 1.5rem; align-items: center; font-weight: 600; }
			nav a { color: #cccccc; transition: color 0.3s; }
			nav a:hover { color: var(--secondary); }
            .lang-switcher { display: flex; gap: 0.5rem; margin-left: 1rem; border-left: 1px solid #333333; padding-left: 1.5rem; }
            .lang-switcher a { border: 1px solid #444444; padding: 3px 10px; border-radius: 0px; font-size: 0.85rem; color: #aaaaaa; }
            .lang-switcher a:hover, .lang-switcher a.active { background: var(--secondary); color: white; border-color: var(--secondary); }
			
			@media (max-width: 768px) {
				.nav-container { flex-direction: column; gap: 15px; }
				nav { flex-wrap: wrap; justify-content: center; gap: 1rem; }
                .lang-switcher { border-left: none; padding-left: 0; margin-left: 0; }
			}
            
            .card { background: var(--card-bg); padding: 30px; border-radius: 0px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border-top: 4px solid transparent; transition: border-color 0.3s ease; }
            .card:hover { border-top: 4px solid var(--secondary); }
            .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
            
            .btn-more { display: inline-block; margin-top: 25px; padding: 12px 30px; background: transparent; color: var(--secondary); border: 2px solid var(--secondary); font-weight: bold; transition: all 0.3s ease; text-align: center; text-transform: uppercase; letter-spacing: 1px; }
            .btn-more:hover { background: var(--secondary); color: white; }
            .center-action { text-align: center; margin-top: 20px; }

            .page-header { background: var(--primary); color: white; padding: 80px 20px; text-align: center; margin-bottom: 40px; border-bottom: 5px solid var(--secondary); }
            .page-header h1 { color: white; margin: 0; font-size: 3rem; text-transform: uppercase; font-weight: 800; }
            .page-header h1::after { content: ''; display: block; width: 80px; height: 5px; background: var(--secondary); margin: 15px auto 0; }

            footer { background: var(--primary); color: #888888; text-align: center; padding: 40px 0; margin-top: 40px; border-top: 5px solid var(--secondary); }
            footer p { margin: 0; }
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>