---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);

const allNews = await getCollection('news', ({ id }) => id.startsWith(`${lang}/`));
const latestNews = allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Layout title={`PLASTart - ${t('strona_tytul')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <section class="hero" style="background: linear-gradient(rgba(10, 10, 10, 0.85), rgba(10, 10, 10, 0.85)), url('https://images.unsplash.com/photo-1504917595217-d4bf804c7bfa?auto=format&fit=crop&q=80&w=2000') center/cover; padding: 140px 20px; text-align: center; color: white; margin-top: 0px; border-bottom: 5px solid var(--secondary);">
            <div class="container">
                <h1 style="color: white; font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.2; margin-bottom: 15px; letter-spacing: -1px; text-transform: uppercase; word-wrap: break-word;">{t('strona_tytul')}</h1>
                <p style="font-size: clamp(1rem, 3vw, 1.3rem); color: #cccccc; max-width: 600px; margin: 0 auto;">{t('strona_podtytul')}</p>
            </div>
        </section>

<!-- SEKCJA O NAS -->
        <section id="about" class="container">
            <h2>{t('o_nas_tytul')}</h2>
            <div class="grid" style="align-items: center; margin-top: 40px;">
                <div class="card" style="border-left: 5px solid var(--secondary); border-top: none;">
                    <p style="font-size: 1.1rem;">{t('o_nas_opis')}</p>
                    <p style="margin-top: 15px; font-weight: bold; color: var(--primary);">{t('o_nas_tworzywa_skrot')}</p>
                </div>
                
				<!-- POKAZ SLAJDÓW -->
                <div class="slideshow-container" style="height: 100%;">
                    {/* Pobieramy 6 pierwszych zdjęć z galerii rozszerzonej */}
                    {Array.from({length: 6}).map((_, i) => (
                        <img 
                            src={`/images/extended${i + 1}.webp`} 
                            alt={`Slajd ${i + 1}`} 
                            class={`slide ${i === 0 ? 'active' : ''}`}
                            loading={i === 0 ? "eager" : "lazy"}
                        />
                    ))}
                    
                    <!-- Guzik na środku zdjęcia -->
                    <div class="overlay-button-container">
                        <a href={`/${lang}/gallery`} class="btn-more" style="margin-top: 0; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                            {t('panel_gorny_galeria')} &rarr;
                        </a>
                    </div>
                </div>

            </div>
            <div class="center-action">
                <a href={`/${lang}/about`} class="btn-more">{t('guzik_szczegoly')}</a>
            </div>
        </section>

        <!-- SEKCJA AKTUALNOŚCI -->
        <section id="news" class="container" style="background-color: #e5e5e5; padding-left: 30px; padding-right: 30px;">
            <h2>{t('aktualnosci_tytul')}</h2>
            <div class="grid" style="margin-top: 40px;">
                {latestNews.map(post => (
                    <div class="card">
                        <div style="font-size: 0.9rem; color: #888888; margin-bottom: 10px; font-weight: bold;">
                            {post.data.date.toLocaleDateString(lang, {year: 'numeric', month: 'long', day: 'numeric'})}
                        </div>
                        <h3 style="margin-top: 0; font-size: 1.2rem; text-transform: uppercase;">
                            <a href={`/${lang}/news/${post.id.split('/')[1]}`} style="color: var(--primary); text-decoration: none;">{post.data.title}</a>
                        </h3>
                        <p>{post.data.description}</p>
                        <a href={`/${lang}/news/${post.id.split('/')[1]}`} style="font-weight: 800; font-size: 0.95rem;">{t('guzik_szczegoly')} &rarr;</a>
                    </div>
                ))}
            </div>
            <div class="center-action">
                <a href={`/${lang}/news`} class="btn-more">{t('guzik_szczegoly')}</a>
            </div>
        </section>

    </main>
    <Footer />
</Layout>

<style>
  /* Styl kontenera pokazu slajdów */
  .slideshow-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    background: #e2e8f0;
  }

  /* Styl pojedynczego zdjęcia (nakładanie na siebie) */
  .slideshow-container .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out; /* Płynne przenikanie (fade) */
    z-index: 1;
  }

  /* Klasa aktywująca widoczność bieżącego zdjęcia */
  .slideshow-container .slide.active {
    opacity: 1;
    z-index: 2;
  }
  
  /* Pozycjonowanie guzika */
  .overlay-button-container {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translate(-50%);
    z-index: 10; /* Warstwa ustawiona wyżej niż zdjęcia (z-index: 2) */
  }
</style>

<script>
  // Zmiana zdjęć co 4 sekundy
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.slideshow-container .slide');
    if (slides.length === 0) return;
    
    let currentSlide = 0;

    setInterval(() => {
      // Ukryj obecny slajd
      slides[currentSlide].classList.remove('active');
      
      // Przejdź do następnego slajdu (wróć do 0, jeśli to koniec)
      currentSlide = (currentSlide + 1) % slides.length;
      
      // Pokaż nowy slajd
      slides[currentSlide].classList.add('active');
    }, 4000); // 4 sekundy
  });
</script>