---
// src/pages/[lang]/gallery-extended.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('galeria_rozszerzona_tytul')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('galeria_rozszerzona_tytul')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            
            <div class="simple-gallery-grid">
                {/* Example mapping for 12 still images */}
                {Array.from({length: 12}).map((_, i) => (
                    <div class="simple-gallery-item" data-src={`/images/extended${i + 1}.webp`}>
                        <img 
                            src={`/images/extended${i + 1}.webp`} 
                            alt={`Realizacja ${i + 1}`} 
                            loading="lazy"
                        />
                    </div>
                ))}
            </div>

            <div style="margin-top: 60px; text-align: center;">
                <a href={`/${lang}/gallery`} class="btn-more">&larr; {t('guzik_powrot')}</a>
            </div>
        </section>
    </main>
    <Footer />

    <!-- Modal for Still Images with Navigation -->
    <dialog id="simple-modal">
        <button id="simple-close" class="close-btn">&times;</button>
        <div class="modal-layout">
            <button id="simple-prev" class="nav-btn">&larr;</button>
            <div class="modal-content">
                <img id="simple-modal-img" src="" alt="Fullscreen view" />
            </div>
            <button id="simple-next" class="nav-btn">&rarr;</button>
        </div>
    </dialog>
</Layout>

<style>
  /* Grid Styles */
  .simple-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 15px;
  }

  .simple-gallery-item {
    width: 100%;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .simple-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .simple-gallery-item:hover img {
    transform: scale(1.05);
  }

  /* Modal Styles */
  dialog#simple-modal {
    width: 95vw;
    max-width: 1200px;
    max-height: 95vh;
    border: none;
    border-radius: 12px;
    background: #111;
    color: white;
    padding: 30px;
  }
  
  dialog#simple-modal::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
  }

  .modal-layout {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative; /* Required for floating buttons */
    height: 100%;
    width: 100%;
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .modal-content img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 8px;
  }

  /* Navigation Button Styles */
  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(51, 51, 51, 0.8);
    color: white;
    border: none;
    padding: 15px 20px;
    font-size: 1.5rem;
    cursor: pointer;
    border-radius: 5px;
    transition: background 0.2s;
    z-index: 10;
  }

  .nav-btn:hover { background: rgba(85, 85, 85, 0.9); }

  #simple-prev { left: -15px; }
  #simple-next { right: -15px; }

  .close-btn {
    position: absolute;
    top: 10px;
    right: 15px;
    background: transparent;
    color: white;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    z-index: 20;
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    dialog#simple-modal {
      width: 100vw;
      max-width: 100vw;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
      padding: 40px 10px 10px 10px;
    }

    .nav-btn {
      padding: 10px 15px;
      font-size: 1.2rem;
    }

    #simple-prev { left: 0px; }
    #simple-next { right: 0px; }
  }
</style>

<script>
  // Client-side Modal Logic for Extended Gallery
  const modal = document.getElementById('simple-modal') as HTMLDialogElement;
  const modalImg = document.getElementById('simple-modal-img') as HTMLImageElement;
  const closeBtn = document.getElementById('simple-close');
  const prevBtn = document.getElementById('simple-prev');
  const nextBtn = document.getElementById('simple-next');

  // Convert NodeList to Array so we can easily get the index
  const items = Array.from(document.querySelectorAll('.simple-gallery-item')) as HTMLElement[];
  let currentIndex = 0;

  // Helper to load the image at the current index
  function updateModalImage() {
    const src = items[currentIndex].dataset.src;
    if (src) {
      modalImg.src = src;
    }
  }

  // Open modal and set starting index
  items.forEach((item, index) => {
    item.addEventListener('click', () => {
      currentIndex = index;
      updateModalImage();
      modal.showModal();
    });
  });

  // Navigation logic (loops around when reaching start/end)
  function showPrev() {
    currentIndex = (currentIndex - 1 + items.length) % items.length;
    updateModalImage();
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % items.length;
    updateModalImage();
  }

  prevBtn?.addEventListener('click', showPrev);
  nextBtn?.addEventListener('click', showNext);

  // Close mechanisms
  closeBtn?.addEventListener('click', () => modal.close());

  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left || e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top || e.clientY > dialogDimensions.bottom
    ) {
      modal.close();
    }
  });

  // Keyboard controls
  document.addEventListener('keydown', (e) => {
    if (modal.open) {
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'Escape') modal.close();
    }
  });
</script>