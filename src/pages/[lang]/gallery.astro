---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('nav.gallery')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('nav.gallery')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            <p style="text-align: center; font-size: 1.1rem; margin-bottom: 40px;">{t('page.gallery.full')}</p>
            
            <div style="margin-bottom: 80px;">
                <h2 style="color: var(--primary); font-size: 2rem;">{t('gallery.cat1.title')}</h2>
                <p style="text-align: center; color: #666666; margin-bottom: 40px;">{t('gallery.cat1.desc')}</p>
                
                <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));">
                    <BeforeAfterSlider 
                        beforeSrc="/images/zd_przed.jpg" 
                        afterSrc="/images/zd_po.jpg" 
                    />
                    <BeforeAfterSlider 
                        beforeSrc="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&q=80&w=800" 
                        afterSrc="https://images.unsplash.com/photo-1616423641402-f8eb065c7198?auto=format&fit=crop&q=80&w=800" 
                    />
                </div>
            </div>

            <div>
                <h2 style="color: var(--primary); font-size: 2rem;">{t('gallery.cat2.title')}</h2>
                <p style="text-align: center; color: #666666; margin-bottom: 40px;">{t('gallery.cat2.desc')}</p>
                
                <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
                    {Array.from({length: 6}).map((_, i) => (
                        <div style="border-radius: 0px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-bottom: 4px solid var(--secondary); transition: transform 0.3s; cursor: pointer;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                            <img src={`https://images.unsplash.com/photo-1587841108253-3b17c10b42f6?auto=format&fit=crop&q=80&w=500&sig=${i}`} alt={`Realizacja ${i + 1}`} style="width: 100%; height: 250px; object-fit: cover; display: block;" />
                        </div>
                    ))}
                </div>
            </div>
            
        </section>
    </main>
    <Footer />
</Layout>