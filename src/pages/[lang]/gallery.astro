---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('nav.gallery')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('nav.gallery')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            <p style="text-align: center; font-size: clamp(1rem, 2.5vw, 1.1rem); margin-bottom: 30px;">{t('page.gallery.full')}</p>
            
            <div style="margin-bottom: 60px;">
                <h2>{t('gallery.cat1.title')}</h2>
                <p style="text-align: center; color: #666666; margin-bottom: 30px;">{t('gallery.cat1.desc')}</p>
                
                <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px;">
                    <BeforeAfterSlider 
                        beforeSrc="/images/Zderzak_przed.webp" 
                        afterSrc="/images/Zderzak_po.webp" 
                    />
                    <BeforeAfterSlider 
                        beforeSrc="/images/Zderzak2_przed.webp" 
                        afterSrc="/images/Zderzak2_po.webp" 
                    />
                </div>
            </div>

            <div>
                <h2>{t('gallery.cat2.title')}</h2>
                <p style="text-align: center; color: #666666; margin-bottom: 30px;">{t('gallery.cat2.desc')}</p>
                
                <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 16px;">
                    {Array.from({length: 8}).map((_, i) => (
                        <div style="overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-bottom: 4px solid var(--secondary); transition: transform 0.3s; cursor: pointer;">
                            <img 
                                src={"/images/Dynks1.webp"} 
                                alt={`Realizacja ${i + 1}`} 
                                style="width: 100%; height: 220px; object-fit: cover; display: block;" 
                                loading="lazy"
                            />
                        </div>
                    ))}
                </div>
            </div>
            
        </section>
    </main>
    <Footer />
</Layout>