---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('nav.gallery')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('nav.gallery')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            <p style="text-align: center; font-size: clamp(1rem, 2.5vw, 1.1rem); margin-bottom: 30px;">{t('page.gallery.full')}</p>
            
            <!-- Zdjęcia ze sliderem -->
            <div style="margin-bottom: 60px;">
                <h2>{t('gallery.cat1.title')}</h2>
                <p style="text-align: center; color: #666666; margin-bottom: 30px;">{t('gallery.cat1.desc')}</p>
                
                <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px;">
                    <BeforeAfterSlider 
                        beforeSrc="/images/slider1_before.webp" 
                        afterSrc="/images/slider1_after.webp" 
                    />
                    <BeforeAfterSlider 
                        beforeSrc="/images/slider2_before.webp" 
                        afterSrc="/images/slider2_after.webp" 
                    />
                </div>
            </div>

            <!-- Siatka zdjęć -->
            <div style="margin-bottom: 60px;">
                <h2>{t('gallery.cat2.title')}</h2>
                <p style="text-align: center; color: #666666; margin-bottom: 30px;">{t('gallery.cat2.desc')}</p>
                
                <div class="gallery-grid">
                    {Array.from({length: 6}).map((_, i) => (
                        <div class="gallery-item" 
                            data-before={`/images/item${i + 1}_before.webp`}
                            data-after={`/images/item${i + 1}_after.webp`}
                            data-anim={`/images/item${i + 1}_anim.webp`}>
                            
                            <!-- Main Visible Image (After) -->
                            <img 
                                src={`/images/item${i + 1}_after.webp`}
                                alt={`Realizacja ${i + 1}`} 
                                class="main-img" 
                                loading="lazy"
                            />

                            <!-- Hover Dropdown Menu -->
                            <div class="hover-dropdown">
                                <img src={`/images/item${i + 1}_before.webp`} alt="Przed" title="Przed naprawą" />
                                <img src={`/images/item${i + 1}_anim.webp`} alt="Animacja" title="Animacja przejścia" />
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            
        </section>
    </main>
    <Footer />

<!-- Pełnoekranowy element modalny do zdjęć -->
    <dialog id="gallery-modal">
        <button id="modal-close" class="close-btn">&times;</button>
        <div class="modal-layout">
            <button id="modal-prev" class="nav-btn">&larr;</button>
            <div class="modal-content">
                <h3 id="modal-title" style="margin-bottom: 10px;">Po naprawie</h3>
                <img id="modal-img" src="" alt="Fullscreen view" />
                
                <!-- Miniaturki do nawigacji -->
                <div class="modal-thumbnails">
                    <img class="modal-thumb" data-index="0" src="" alt="Przed" title="Przed naprawą" />
                    <img class="modal-thumb active" data-index="1" src="" alt="Po" title="Po naprawie" />
                    <img class="modal-thumb" data-index="2" src="" alt="Animacja" title="Animacja przejścia" />
                </div>
            </div>
            <button id="modal-next" class="nav-btn">&rarr;</button>
        </div>
    </dialog>
</Layout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  .gallery-item {
    position: relative;
    width: 100%;
    aspect-ratio: 1200 / 800;
    cursor: pointer;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    border-bottom: 4px solid var(--secondary, #0056b3);
  }
  
  .gallery-item .main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .hover-dropdown {
    position: absolute;
    bottom: -100px; /* Hidden below by default */
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    background: rgba(0, 0, 0, 0.75);
    padding: 10px;
    border-radius: 8px 8px 0 0;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .gallery-item:hover .main-img {
    transform: scale(1.02);
  }

  .gallery-item:hover .hover-dropdown {
    bottom: 0; /* Slides up on hover */
    opacity: 1;
    visibility: visible;
  }

  .hover-dropdown img {
    width: 90px;
    aspect-ratio: 1200 / 800;
    object-fit: cover;
    border: 2px solid white;
    border-radius: 4px;
  }

  /* Modal Styles */
  dialog#gallery-modal {
    max-width: 95vw;
    max-height: 95vh;
    border: none;
    border-radius: 12px;
    background: #111;
    color: white;
    padding: 30px;
  }
  
  dialog#gallery-modal::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
  }

  .modal-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    height: 100%;
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
  }

  .modal-content img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 8px;
  }
  
  .modal-thumbnails {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    justify-content: center;
  }

  .modal-thumb {
    width: 90px;
    aspect-ratio: 1200 / 800;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 3px solid transparent;
    opacity: 0.5;
    transition: all 0.2s ease;
  }

  .modal-thumb:hover {
    opacity: 0.8;
  }

  .modal-thumb.active {
    border-color: white; 
    opacity: 1;
    transform: scale(1.05);
  }

  .nav-btn {
    background: #333;
    color: white;
    border: none;
    padding: 15px 20px;
    font-size: 1.5rem;
    cursor: pointer;
    border-radius: 5px;
    transition: background 0.2s;
  }

  .nav-btn:hover { background: #555; }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 15px;
    background: transparent;
    color: white;
    border: none;
    font-size: 2rem;
    cursor: pointer;
  }
</style>

<script>
  // --- Client-side Modal Logic ---
  const modal = document.getElementById('gallery-modal') as HTMLDialogElement;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const closeBtn = document.getElementById('modal-close');
  const prevBtn = document.getElementById('modal-prev');
  const nextBtn = document.getElementById('modal-next');
  const thumbnails = document.querySelectorAll('.modal-thumb');

  let currentItem: any = null;
  let currentStateIndex = 1; // 0: Przed, 1: Po, 2: Animacja
  
  const states = ['before', 'after', 'anim'];
  const stateTitles = ['Przed naprawą', 'Po naprawie', 'Animacja przejścia']; 

  // Open modal on item click
  document.querySelectorAll('.gallery-item').forEach(item => {
    item.addEventListener('click', () => {
      const htmlItem = item as HTMLElement;
      currentItem = {
        before: htmlItem.dataset.before,
        after: htmlItem.dataset.after,
        anim: htmlItem.dataset.anim
      };
      currentStateIndex = 1; 
      updateModal();
      modal.showModal();
    });
  });

  // Close mechanisms
  closeBtn?.addEventListener('click', () => modal.close());
  
  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left || e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top || e.clientY > dialogDimensions.bottom
    ) {
      modal.close();
    }
  });

  // Update image inside modal and sync thumbnails
  function updateModal() {
    if (!currentItem) return;
    
    // Update main display
    modalImg.src = currentItem[states[currentStateIndex]];
    modalTitle.textContent = stateTitles[currentStateIndex];

    // Update thumbnails (src and active state)
    thumbnails.forEach((thumb, index) => {
      const thumbEl = thumb as HTMLImageElement;
      thumbEl.src = currentItem[states[index]];
      
      if (index === currentStateIndex) {
        thumbEl.classList.add('active');
      } else {
        thumbEl.classList.remove('active');
      }
    });
  }

  // Handle Thumbnail Clicks
  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      currentStateIndex = parseInt(target.dataset.index || '0', 10);
      updateModal();
    });
  });

  // Navigation button logic
  function showPrevious() {
    currentStateIndex = (currentStateIndex - 1 + 3) % 3;
    updateModal();
  }

  function showNext() {
    currentStateIndex = (currentStateIndex + 1) % 3;
    updateModal();
  }

  prevBtn?.addEventListener('click', showPrevious);
  nextBtn?.addEventListener('click', showNext);

  // Keyboard Event Listeners for Arrow Keys
  document.addEventListener('keydown', (e) => {
    if (modal.open) {
      if (e.key === 'ArrowLeft') {
        showPrevious();
      } else if (e.key === 'ArrowRight') {
        showNext();
      } else if (e.key === 'Escape') {
        modal.close();
      }
    }
  });
</script>