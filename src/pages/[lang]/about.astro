---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('nav.about')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('nav.about')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            <div class="card" style="font-size: 1.1rem; line-height: 1.8;">
                <p><strong>{t('about.desc')}</strong></p>
                <p>{t('page.about.full')}</p>
                <p>{t('about.materials')}</p>
            </div>
        </section>
    </main>
    <Footer />
</Layout>