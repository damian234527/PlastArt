---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('nav.contact')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('nav.contact')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            <div class="grid" style="max-width: 600px; margin: 0 auto;">
                <div class="card">
                    <h3 style="margin-top: 0; font-size: 1.4rem;">Dane adresowe</h3>
                    <p style="margin-bottom: 15px;"><strong>PLASTart</strong><br/>{t('contact.address')}</p>
                    <p style="margin-top: 20px; line-height: 2;">
                        <strong>Telefon:</strong> <a href={`tel:${t('contact.phone')}`} style="display: inline-block; padding: 2px 0;">{t('contact.phone')}</a><br/>
                        <strong>Email:</strong> <a href={`mailto:${t('contact.email')}`} style="display: inline-block; padding: 2px 0;">{t('contact.email')}</a>
                    </p>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>