---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${t('nav.contact')}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header">
            <div class="container">
                <h1>{t('nav.contact')}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0;">
            <!-- Updated Grid to accommodate two columns -->
            <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; max-width: 1000px; margin: 0 auto;">
                
                <!-- Contact Info Card -->
                <div class="card">
                    <h3 style="margin-top: 0; font-size: 1.4rem;">Dane adresowe</h3>
                    <p style="margin-bottom: 15px;"><strong>PLASTart</strong><br/>{t('contact.address')}</p>
                    <p style="margin-top: 20px; line-height: 2;">
                        <strong>Telefon:</strong> <a href={`tel:${t('contact.phone')}`} style="display: inline-block; padding: 2px 0;">{t('contact.phone')}</a><br/>
                        <strong>Email:</strong> <a href={`mailto:${t('contact.email')}`} style="display: inline-block; padding: 2px 0;">{t('contact.email')}</a>
                    </p>
                </div>

                <!-- Interactive Map -->
                <div class="map-container" style="min-height: 300px; height: 100%;">
                    <iframe 
                        width="100%" 
                        height="100%" 
                        style="border:0; border-radius: 8px; min-height: 300px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);" 
                        loading="lazy" 
                        allowfullscreen 
                        referrerpolicy="no-referrer-when-downgrade"
                        src={`https://maps.google.com/maps?q=${encodeURIComponent(t('contact.address'))}&t=&z=15&ie=UTF8&iwloc=B&output=embed`}>
                    </iframe>
                </div>

            </div>
        </section>
    </main>
    <Footer />
</Layout>