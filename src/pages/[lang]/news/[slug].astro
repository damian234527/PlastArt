---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { ui, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
    const allNews = await getCollection('news');
    return allNews.map(entry => {
        const [lang, ...slugParts] = entry.slug.split('/');
        const slug = slugParts.join('/');
        return {
            params: { lang, slug },
            props: { entry },
        };
    });
}

const { lang } = Astro.params;
const { entry } = Astro.props;
const { Content } = await entry.render();
const t = useTranslations(lang as keyof typeof ui);
---
<Layout title={`PLASTart - ${entry.data.title}`} lang={lang}>
    <Header lang={lang} />
    <main>
        <div class="page-header" style="padding: 50px 20px;">
            <div class="container" style="max-width: 800px;">
                <h1 style="font-size: 2.5rem; text-align: center;">{entry.data.title}</h1>
            </div>
        </div>
        <section class="container" style="padding-top: 0; max-width: 800px;">
            <div class="card prose">
                <!-- Metadata: Date and Author -->
                <div style="color: var(--secondary); font-size: 0.9rem; margin-bottom: 20px; font-weight: bold;">
                    {entry.data.date.toLocaleDateString(lang, {year: 'numeric', month: 'long', day: 'numeric'})} &bull; {entry.data.author}
                </div>

                <!-- Optional Image -->
                {entry.data.image && (
                    <img 
                        src={entry.data.image} 
                        alt={entry.data.title} 
                        style="width: 100%; height: auto; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 20px;" 
                    />
                )}

                <!-- Optional Description as a lead paragraph -->
                {entry.data.description && (
                    <p style="font-size: 1.1rem; font-weight: bold; margin-bottom: 20px; border-left: 4px solid var(--secondary); padding-left: 15px;">
                        {entry.data.description}
                    </p>
                )}

                <!-- Main Markdown Content -->
                <Content />
            </div>
            <div style="margin-top: 40px;">
                <a href={`/${lang}/news`} class="btn-more" style="margin-top: 0;">&larr; {t('button.back')}</a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>