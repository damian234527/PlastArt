---
import { languages, useTranslations } from '../i18n/utils';
const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<footer>
    <div class="container">
        <p>PLASTart</p>
		<p>{t('contact.address')}</p>
		<p>Telefon: {t('contact.phone')}</p>
		<p>E-mail: {t('contact.email')}</p>
    </div>
</footer>
