---
import { languages, useTranslations } from '../i18n/utils';
const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---
<footer>
    <div class="container">
        <p>PLASTart</p>
		<p>{t('kontakt_adres')}</p>
		<p>{t('kontakt_telefon_tytul')}: {t('kontakt_telefon_numer')}</p>
		<p>E-mail: {t('kontakt_email')}</p>
    </div>
</footer>
